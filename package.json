{
  "name": "taifa-mail-desktop",
  "productName": "Taifa Mail",
  "version": "0.1.2",
  "description": "Taifa Mail desktop: a thin Electron shell around the Taifa Mail webmail at mail.govconnect.ke.",
  "main": "src/main.js",
  "author": "RCFI",
  "homepage": "https://mail.govconnect.ke",
  "license": "UNLICENSED",
  "private": true,
  "//": "Four things in the build key below are load-bearing and must not be tidied away: the top-level 'artifactName' (productName has a space, and a space breaks auto-update: see RELEASING.md), the 'zip' mac target (electron-updater cannot update from a .dmg), the hardcoded notarize.teamId literal (electron-builder does not interpolate ${env.APPLE_TEAM_ID} there), and the entitlements plist (copied verbatim, required by the hardened runtime). See RELEASING.md before changing any of them.",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --publish never",
    "pack": "electron-builder --dir",
    "release": "node scripts/release.mjs",
    "test": "node --test tests/*.test.js",
    "test:electron": "electron tests/electron-smoke.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "openid-client": "6.8.8"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ke.govconnect.taifamail",
    "productName": "Taifa Mail",
    "artifactName": "TaifaMail-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "GovConnectKenya",
        "repo": "taifa-mail-desktop"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/branding/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": {
        "teamId": "YAD95QLFD7"
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/branding/icon.ico",
      "artifactName": "TaifaMail-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network;Email",
      "maintainer": "RCFI <support@govconnect.ke>"
    },
    "protocols": [
      {
        "name": "Taifa Mail central authentication",
        "schemes": [
          "ke.govconnect.taifamail.auth"
        ]
      }
    ]
  }
}
