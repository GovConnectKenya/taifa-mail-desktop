{
  "name": "taifa-mail-desktop",
  "productName": "Taifa Mail",
  "version": "0.2.0",
  "description": "Taifa Mail desktop: the Taifa Mail webmail, bundled into a native app for macOS, Windows and Linux.",
  "main": "src/main.js",
  "author": "RCFI",
  "homepage": "https://mail.govconnect.ke",
  "license": "UNLICENSED",
  "private": true,
  "//": "Four things in the build key below are load-bearing and must not be tidied away: the top-level 'artifactName' (productName has a space, and a space breaks auto-update: see RELEASING.md), the 'zip' mac target (electron-updater cannot update from a .dmg), the hardcoded notarize.teamId literal (electron-builder does not interpolate ${env.APPLE_TEAM_ID} there), and the entitlements plist (copied verbatim, required by the hardened runtime). See RELEASING.md before changing any of them.",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "stage": "node scripts/stage-webmail.mjs",
    "dist": "node scripts/stage-webmail.mjs && electron-builder --publish never && node scripts/set-min-macos.mjs",
    "pack": "node scripts/stage-webmail.mjs && electron-builder --dir",
    "release": "node scripts/release.mjs",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "^45.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "ke.govconnect.taifamail",
    "productName": "Taifa Mail",
    "artifactName": "TaifaMail-${version}-${arch}.${ext}",
    "afterPack": "scripts/after-pack.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "renderer/**/*"
    ],
    "protocols": [
      {
        "name": "Email",
        "schemes": [
          "mailto"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "GovConnectKenya",
        "repo": "taifa-mail-desktop"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/branding/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": {
        "teamId": "YAD95QLFD7"
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/branding/icon.ico",
      "artifactName": "TaifaMail-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/branding/icon.png",
      "category": "Network;Email",
      "executableName": "taifa-mail",
      "artifactName": "TaifaMail-${version}-linux-${arch}.${ext}",
      "synopsis": "Taifa Mail",
      "maintainer": "RCFI <support@govconnect.ke>",
      "desktop": {
        "Name": "Taifa Mail",
        "Comment": "Taifa Mail desktop",
        "StartupWMClass": "taifa-mail",
        "MimeType": "x-scheme-handler/mailto;",
        "Categories": "Network;Email;"
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "libgbm1",
        "libdrm2"
      ]
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "libuuid",
        "libsecret",
        "alsa-lib",
        "mesa-libgbm",
        "libdrm"
      ]
    }
  },
  "desktopName": "taifa-mail.desktop"
}
