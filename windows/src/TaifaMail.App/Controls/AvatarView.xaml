<UserControl
    x:Class="TaifaMail.App.Controls.AvatarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
  <Grid x:Name="_root">
    <Border x:Name="_placeholder"/>
    <TextBlock x:Name="_initial" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <Border x:Name="_logo" Visibility="Collapsed" Background="{ThemeResource TmPanel2Brush}">
      <Image x:Name="_logoImage" Stretch="Uniform"/>
    </Border>
    <Border x:Name="_photo" Visibility="Collapsed"/>
  </Grid>
</UserControl>
