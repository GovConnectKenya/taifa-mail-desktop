<Page
    x:Class="TaifaMail.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:TaifaMail.App.Controls"
    xmlns:svc="using:TaifaMail.App.Services"
    xmlns:vm="using:TaifaMail.Core.ViewModels"
    xmlns:m="using:TaifaMail.Core.Models">

  <Page.Resources>
    <DataTemplate x:Key="ThreadRowTemplate" x:DataType="vm:ThreadRow">
      <Grid Height="76" Padding="4,12,12,12" ColumnSpacing="8" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource TmBorderSoftBrush}" AutomationProperties.Name="{x:Bind SpokenName}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="36"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Ellipse Width="8" Height="8" Fill="{ThemeResource TmAccentFgBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"
                 Visibility="{x:Bind svc:Fmt.Show(Unread), Mode=OneWay}"/>
        <ctl:AvatarView Grid.Column="1" Size="36" VerticalAlignment="Top" Decision="{x:Bind Avatar, Mode=OneWay}" Initials="{x:Bind Initials}" FillColor="{x:Bind PlaceholderColor}"/>
        <Grid Grid.Column="2" RowSpacing="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="18"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="16"/>
          </Grid.RowDefinitions>
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource TmBody}" FontWeight="{x:Bind svc:Fmt.Bold(Unread), Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
            <Border Grid.Column="1" CornerRadius="4" Padding="4,0" Background="{ThemeResource TmPanel3Brush}" VerticalAlignment="Center" Visibility="{x:Bind svc:Fmt.ShowIf(Count, 2)}">
              <TextBlock Text="{x:Bind Count}" Style="{StaticResource TmCaption}"/>
            </Border>
            <TextBlock Grid.Column="2" Text="{x:Bind svc:Fmt.Time(When)}" Style="{StaticResource TmCaption}" FontWeight="{x:Bind svc:Fmt.Bold(Unread), Mode=OneWay}"/>
            <TextBlock Grid.Column="2" Text="{x:Bind svc:Fmt.Time(When)}" Style="{StaticResource TmCaption}" FontWeight="Bold" Foreground="{ThemeResource TmAccentInkBrush}" Visibility="{x:Bind svc:Fmt.Show(Unread), Mode=OneWay}"/>
          </Grid>
          <Grid Grid.Row="1" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind Subject}" Style="{StaticResource TmBody}" FontWeight="{x:Bind svc:Fmt.Weight(Unread), Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
            <ctl:IconView Grid.Column="1" IconName="flag" Size="16" Foreground="{ThemeResource TmFlagBrush}" Visibility="{x:Bind svc:Fmt.Show(Flagged), Mode=OneWay}"/>
            <ctl:IconView Grid.Column="2" IconName="attach" Size="16" Foreground="{ThemeResource TmText3Brush}" Visibility="{x:Bind svc:Fmt.Show(HasAttachment)}"/>
          </Grid>
          <TextBlock Grid.Row="2" Text="{x:Bind Snippet}" Style="{StaticResource TmMeta}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
        </Grid>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="MessageCardTemplate" x:DataType="vm:MessageCardVm">
      <Border Margin="0,0,0,8" CornerRadius="12" BorderThickness="1" Background="{ThemeResource TmPanelBrush}" BorderBrush="{ThemeResource TmBorderBrush}">
        <StackPanel>
          <!-- header: collapsed 56, expanded 72 or more -->
          <Grid Padding="16,8" MinHeight="56" Background="Transparent" Tapped="OnCardHeaderTapped" ColumnSpacing="12" AutomationProperties.Name="{x:Bind DisplayName}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="40"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ctl:AvatarView Size="40" VerticalAlignment="Center" Decision="{x:Bind Avatar, Mode=OneWay}" Initials="{x:Bind Initials}" FillColor="{x:Bind PlaceholderColor}"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource TmBodyStrong}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{x:Bind AvatarAddress}" Style="{StaticResource TmMono}" TextWrapping="WrapWholeWords" Visibility="{x:Bind svc:Fmt.Show(Expanded), Mode=OneWay}" IsTextSelectionEnabled="True"/>
              </StackPanel>
              <TextBlock Text="{x:Bind ToLine}" Style="{StaticResource TmMeta}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind svc:Fmt.Show(Expanded), Mode=OneWay}"/>
              <TextBlock Text="{x:Bind FirstLine}" Style="{StaticResource TmMeta}" TextTrimming="CharacterEllipsis" MaxLines="1" Visibility="{x:Bind svc:Fmt.Hide(Expanded), Mode=OneWay}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <ctl:IconView IconName="attach" Size="16" Foreground="{ThemeResource TmText3Brush}" Visibility="{x:Bind svc:Fmt.Show(HasAttachments)}"/>
              <ctl:IconView IconName="flag" Size="16" Foreground="{ThemeResource TmFlagBrush}" Visibility="{x:Bind svc:Fmt.Show(Flagged)}"/>
              <TextBlock Text="{x:Bind svc:Fmt.Long(When)}" Style="{StaticResource TmMeta}"/>
            </StackPanel>
          </Grid>
          <StackPanel Visibility="{x:Bind svc:Fmt.Show(Expanded), Mode=OneWay}" Padding="16,0,16,16" Spacing="12">
            <InfoBar IsOpen="{x:Bind HasAuthBanner}" IsClosable="False" Severity="{x:Bind svc:Fmt.AuthSeverity(AuthLevel)}" Title="{x:Bind Detail.AuthWarning.Title}" Message="{x:Bind Detail.AuthWarning.Message}"/>
            <InfoBar IsOpen="{x:Bind ShowImagesPrompt, Mode=OneWay}" IsClosable="False" Severity="Informational" Message="Remote images are blocked.">
              <InfoBar.ActionButton>
                <Button Content="Show images" Click="OnShowImages" Style="{StaticResource TmTextButton}"/>
              </InfoBar.ActionButton>
            </InfoBar>
            <ContentControl Loaded="OnBodyHostLoaded" HorizontalContentAlignment="Stretch"/>
            <ItemsRepeater ItemsSource="{x:Bind Attachments}" Visibility="{x:Bind svc:Fmt.Show(HasAttachments)}">
              <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="240" MinItemHeight="40" MinRowSpacing="8" MinColumnSpacing="8" ItemsStretch="None"/>
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="m:ApiAttachment">
                  <Grid Height="40" Width="240" CornerRadius="8" Background="{ThemeResource TmPanel2Brush}" ColumnSpacing="8" Padding="12,0,4,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ctl:IconView IconName="attach" Size="16" VerticalAlignment="Center" Foreground="{ThemeResource TmText2Brush}"/>
                    <Button Grid.Column="1" Style="{StaticResource TmTextButton}" Padding="0" HorizontalContentAlignment="Left" Click="OnAttachmentOpen" Tag="{x:Bind}" AutomationProperties.Name="{x:Bind Filename}">
                      <StackPanel>
                        <TextBlock Text="{x:Bind Filename}" Style="{StaticResource TmBody}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        <TextBlock Text="{x:Bind svc:Fmt.Size(Size)}" Style="{StaticResource TmCaption}"/>
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource TmTextButton}" Width="32" Padding="0" Click="OnAttachmentSave" Tag="{x:Bind}" ToolTipService.ToolTip="Save" AutomationProperties.Name="Save attachment">
                      <ctl:IconView IconName="save" Size="16" Foreground="{ThemeResource TmText2Brush}"/>
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="48"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Title bar row: brand, search, commands. Empty space drags the window; the controls are pass through regions. -->
    <Grid x:Name="TitleRow" Background="Transparent" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition x:Name="CaptionInsetColumn" Width="138"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
        <ctl:LogoView HeightPx="24"/>
        <TextBlock Text="Taifa Mail" Style="{StaticResource TmBodyStrong}" VerticalAlignment="Center"/>
      </StackPanel>
      <Grid x:Name="SearchHost" Grid.Column="1" Width="360" Height="32" CornerRadius="8" Background="{ThemeResource TmPanel2Brush}" VerticalAlignment="Center">
        <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ctl:IconView IconName="search" Size="16" Foreground="{ThemeResource TmText3Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="Search in this folder" BorderThickness="0" Background="Transparent"
                 AutomationProperties.Name="Search" VerticalAlignment="Center" TextChanged="OnSearchTextChanged" KeyDown="OnSearchKeyDown" FontFamily="{StaticResource TmFont}"/>
      </Grid>
      <StackPanel x:Name="CommandHost" Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button x:Name="RefreshButton" Style="{StaticResource TmTextButton}" Width="32" Padding="0" Click="OnRefresh" ToolTipService.ToolTip="Refresh (F5)" AutomationProperties.Name="Refresh">
          <ctl:IconView IconName="refresh" Size="18" Foreground="{ThemeResource TmText2Brush}"/>
        </Button>
      </StackPanel>
    </Grid>

    <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                    IsPaneToggleButtonVisible="False" OpenPaneLength="240" IsPaneOpen="True" CompactModeThresholdWidth="0" ExpandedModeThresholdWidth="0"
                    Background="Transparent" SelectionChanged="OnFolderSelected" AlwaysShowHeader="False">
      <NavigationView.PaneHeader>
        <Button x:Name="IdentityButton" Style="{StaticResource TmTextButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="8,4,8,8" Padding="8,6" Height="Auto" AutomationProperties.Name="Mailbox and account">
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ctl:AvatarView x:Name="IdentityAvatar" Size="28" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="IdentityName" Style="{StaticResource TmBodyStrong}" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="IdentityAddress" Style="{StaticResource TmMeta}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <ctl:IconView Grid.Column="2" IconName="chevron-down" Size="16" Foreground="{ThemeResource TmText3Brush}" VerticalAlignment="Center"/>
          </Grid>
          <Button.Flyout>
            <MenuFlyout x:Name="IdentityFlyout" Opening="OnIdentityOpening"/>
          </Button.Flyout>
        </Button>
      </NavigationView.PaneHeader>

      <Grid x:Name="Panes">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="ListColumn" Width="360" MinWidth="300" MaxWidth="480"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*" MinWidth="420"/>
        </Grid.ColumnDefinitions>

        <!-- Thread list -->
        <Grid Background="{ThemeResource TmPanelBrush}" BorderBrush="{ThemeResource TmBorderBrush}" BorderThickness="1" CornerRadius="12,0,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Padding="16,12,16,8" ColumnSpacing="8">
            <TextBlock x:Name="ListTitle" Style="{StaticResource TmTitle}" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SelectedCount" HorizontalAlignment="Right" Style="{StaticResource TmMeta}" Visibility="Collapsed"/>
          </Grid>
          <StackPanel Grid.Row="1">
            <InfoBar x:Name="OfflineBar" IsClosable="False" Severity="Warning" Message="Offline. Showing the last synced mail." IsOpen="{x:Bind Vm.Offline, Mode=OneWay}"/>
            <InfoBar x:Name="ErrorBar" IsClosable="False" Severity="Error" IsOpen="{x:Bind svc:Fmt.HasText(Vm.Error), Mode=OneWay}" Message="{x:Bind Vm.Error, Mode=OneWay}">
              <InfoBar.ActionButton>
                <Button Content="Retry" Click="OnRefresh" Style="{StaticResource TmTextButton}"/>
              </InfoBar.ActionButton>
            </InfoBar>
          </StackPanel>
          <Grid Grid.Row="2">
            <ListView x:Name="ThreadList" ItemsSource="{x:Bind Vm.Threads}" ItemTemplate="{StaticResource ThreadRowTemplate}" ItemContainerStyle="{StaticResource TmRowContainer}"
                      SelectionMode="Extended" SelectionChanged="OnThreadSelectionChanged" IsItemClickEnabled="False" ShowsScrollingPlaceholders="False" Loaded="OnThreadListLoaded"
                      AutomationProperties.Name="Messages"/>
            <!-- loading skeleton -->
            <ItemsControl x:Name="Skeleton" IsHitTestVisible="False" Visibility="Collapsed">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Height="76" Padding="16,12" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Ellipse Width="36" Height="36" Fill="{ThemeResource TmTrackBrush}" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                      <Border Height="10" Width="160" HorizontalAlignment="Left" CornerRadius="4" Background="{ThemeResource TmTrackBrush}"/>
                      <Border Height="10" CornerRadius="4" Background="{ThemeResource TmTrackBrush}"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- empty -->
            <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
              <ctl:LogoView HeightPx="40" HorizontalAlignment="Center"/>
              <TextBlock Text="Nothing here" Style="{StaticResource TmDisplay}" HorizontalAlignment="Center"/>
              <TextBlock x:Name="EmptyHint" Text="This folder has no messages." Style="{StaticResource TmMeta}" HorizontalAlignment="Center"/>
            </StackPanel>
            <ProgressRing x:Name="MoreRing" Width="20" Height="20" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8" IsActive="{x:Bind Vm.LoadingMore, Mode=OneWay}"/>
          </Grid>
        </Grid>

        <Border x:Name="Splitter" Grid.Column="1" Width="8" Background="Transparent" PointerPressed="OnSplitterPressed" PointerMoved="OnSplitterMoved" PointerReleased="OnSplitterReleased" PointerCaptureLost="OnSplitterReleased">
          <Border Width="1" HorizontalAlignment="Center" Background="{ThemeResource TmBorderBrush}"/>
        </Border>

        <!-- Reader -->
        <Grid Grid.Column="2" Background="{ThemeResource TmBgBrush}">
          <ScrollViewer x:Name="ReaderScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Padding="24">
              <TextBlock x:Name="ReaderSubject" Style="{StaticResource TmTitle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,0,0,16"/>
              <InfoBar x:Name="ReadBar" IsClosable="True" Severity="Warning" Margin="0,0,0,12" Message="Could not mark as read" IsOpen="{x:Bind svc:Fmt.HasText(Vm.OpenError), Mode=OneWay}"/>
              <ItemsControl x:Name="Cards" ItemsSource="{x:Bind Vm.OpenMessages}" ItemTemplate="{StaticResource MessageCardTemplate}"/>
            </StackPanel>
          </ScrollViewer>
          <StackPanel x:Name="ReaderEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <ctl:LogoView HeightPx="40" HorizontalAlignment="Center"/>
            <TextBlock Text="Select a message" Style="{StaticResource TmDisplay}" HorizontalAlignment="Center"/>
          </StackPanel>
          <StackPanel x:Name="ReaderSkeleton" Visibility="Collapsed" Padding="24" Spacing="12" VerticalAlignment="Top">
            <Border Height="16" Width="280" HorizontalAlignment="Left" CornerRadius="4" Background="{ThemeResource TmTrackBrush}"/>
            <Border Height="10" CornerRadius="4" Background="{ThemeResource TmTrackBrush}"/>
            <Border Height="10" CornerRadius="4" Background="{ThemeResource TmTrackBrush}"/>
            <Border Height="10" CornerRadius="4" Background="{ThemeResource TmTrackBrush}"/>
            <Border Height="10" CornerRadius="4" Background="{ThemeResource TmTrackBrush}"/>
            <Border Height="10" Width="200" HorizontalAlignment="Left" CornerRadius="4" Background="{ThemeResource TmTrackBrush}"/>
          </StackPanel>
          <Border x:Name="ReaderError" Visibility="Collapsed" Width="360" Padding="24" CornerRadius="12" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Background="{ThemeResource TmPanelBrush}" BorderBrush="{ThemeResource TmBorderBrush}">
            <StackPanel Spacing="12">
              <TextBlock Text="Could not load this message" Style="{StaticResource TmTitle}"/>
              <TextBlock x:Name="ReaderErrorText" Style="{StaticResource TmMeta}" TextWrapping="Wrap"/>
              <Button Content="Retry" Click="OnRetryOpen" Style="{StaticResource TmPrimaryButton}" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </NavigationView>
  </Grid>
</Page>
