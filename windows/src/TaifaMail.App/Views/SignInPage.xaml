<Page
    x:Class="TaifaMail.App.Views.SignInPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:TaifaMail.App.Controls"
    xmlns:svc="using:TaifaMail.App.Services">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="TitleRow" Background="Transparent">
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
        <ctl:LogoView HeightPx="24"/>
        <TextBlock Text="Taifa Mail" Style="{StaticResource TmBodyStrong}" VerticalAlignment="Center"/>
      </StackPanel>
    </Grid>
    <Border x:Name="Card" Grid.Row="1" Margin="24" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center"
            Padding="24" CornerRadius="16" BorderThickness="1"
            Background="{ThemeResource TmPanelBrush}" BorderBrush="{ThemeResource TmBorderBrush}">
      <StackPanel Spacing="16">
        <StackPanel Spacing="8">
          <ctl:LogoView HeightPx="56" HorizontalAlignment="Left"/>
          <TextBlock Text="Taifa Mail" Style="{StaticResource TmHero}"/>
          <TextBlock x:Name="Subtitle" Text="Sign in to your mailbox" Style="{StaticResource TmMeta}"/>
        </StackPanel>

        <InfoBar x:Name="EndedBar" Severity="Warning" IsOpen="False" IsClosable="False" Message="Your session ended. Sign in again."/>
        <InfoBar x:Name="OfflineBar" Severity="Warning" IsClosable="False" IsOpen="{x:Bind Vm.Offline, Mode=OneWay}" Message="You are offline. Connect to sign in."/>

        <!-- Step 1: address and password -->
        <StackPanel Spacing="16" Visibility="{x:Bind Vm.ShowPassword, Mode=OneWay}">
          <StackPanel Spacing="8">
            <TextBlock Text="Mailbox address" Style="{StaticResource TmBody}"/>
            <TextBox x:Name="AddressBox" Style="{StaticResource TmFieldMono}" PlaceholderText="name@institution.go.ke"
                     AutomationProperties.Name="Mailbox address" InputScope="EmailSmtpAddress" IsSpellCheckEnabled="False"
                     Text="{x:Bind Vm.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind Vm.Idle, Mode=OneWay}"
                     KeyDown="OnFieldKeyDown"/>
          </StackPanel>
          <StackPanel Spacing="8">
            <TextBlock Text="Password" Style="{StaticResource TmBody}"/>
            <PasswordBox x:Name="PasswordField" Style="{StaticResource TmFieldPassword}" AutomationProperties.Name="Password"
                         Password="{x:Bind Vm.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind Vm.Idle, Mode=OneWay}"
                         KeyDown="OnFieldKeyDown"/>
          </StackPanel>
          <InfoBar Severity="Error" IsClosable="False" IsOpen="{x:Bind svc:Fmt.HasText(Vm.Error), Mode=OneWay}" Message="{x:Bind Vm.Error, Mode=OneWay}"/>
          <Button x:Name="SignInButton" Style="{StaticResource TmPrimaryButton}" HorizontalAlignment="Stretch" Height="36"
                  IsEnabled="{x:Bind Vm.CanSubmitPassword, Mode=OneWay}" Click="OnSignIn" AutomationProperties.Name="Sign in">
            <Grid>
              <TextBlock Text="Sign in" Visibility="{x:Bind svc:Fmt.Hide(Vm.Busy), Mode=OneWay}" HorizontalAlignment="Center"/>
              <ProgressRing IsActive="{x:Bind Vm.Busy, Mode=OneWay}" Width="16" Height="16" Foreground="White" HorizontalAlignment="Center"/>
            </Grid>
          </Button>
          <Button Style="{StaticResource TmTextButton}" HorizontalAlignment="Stretch" IsEnabled="{x:Bind Vm.CanRequestCode, Mode=OneWay}" Click="OnEmailCode">
            <TextBlock Text="Email me a sign-in code" Foreground="{ThemeResource TmAccentInkBrush}"/>
          </Button>
          <TextBlock Text="Passkey sign-in is not available in this version." Style="{StaticResource TmMeta}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Step 2 and 3: sign-in code or second factor -->
        <StackPanel Spacing="16" Visibility="{x:Bind svc:Fmt.Or(Vm.ShowCode, Vm.ShowSecondFactor), Mode=OneWay}">
          <TextBlock Text="{x:Bind Vm.Notice, Mode=OneWay}" Style="{StaticResource TmMeta}" TextWrapping="Wrap" Visibility="{x:Bind svc:Fmt.ShowStr(Vm.Notice), Mode=OneWay}"/>
          <StackPanel Spacing="8">
            <TextBlock Text="{x:Bind Vm.CodeTitle, Mode=OneWay}" Style="{StaticResource TmBody}"/>
            <TextBox x:Name="CodeBox" Style="{StaticResource TmFieldMono}" AutomationProperties.Name="Verification code" MaxLength="24"
                     Text="{x:Bind Vm.Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind Vm.Idle, Mode=OneWay}" KeyDown="OnCodeKeyDown"/>
          </StackPanel>
          <InfoBar Severity="Error" IsClosable="False" IsOpen="{x:Bind svc:Fmt.HasText(Vm.Error), Mode=OneWay}" Message="{x:Bind Vm.Error, Mode=OneWay}"/>
          <Button Style="{StaticResource TmPrimaryButton}" HorizontalAlignment="Stretch" Height="36" Click="OnVerify" IsEnabled="{x:Bind Vm.Idle, Mode=OneWay}">
            <Grid>
              <TextBlock Text="Verify" Visibility="{x:Bind svc:Fmt.Hide(Vm.Busy), Mode=OneWay}" HorizontalAlignment="Center"/>
              <ProgressRing IsActive="{x:Bind Vm.Busy, Mode=OneWay}" Width="16" Height="16" Foreground="White" HorizontalAlignment="Center"/>
            </Grid>
          </Button>
          <Button Style="{StaticResource TmTextButton}" HorizontalAlignment="Stretch" Click="OnEmailSecondFactor" Visibility="{x:Bind Vm.ShowSecondFactor, Mode=OneWay}">
            <TextBlock Text="Email me a code" Foreground="{ThemeResource TmAccentInkBrush}"/>
          </Button>
          <Button Style="{StaticResource TmTextButton}" HorizontalAlignment="Stretch" Click="OnBack">
            <TextBlock Text="Back" Foreground="{ThemeResource TmText2Brush}"/>
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Page>
