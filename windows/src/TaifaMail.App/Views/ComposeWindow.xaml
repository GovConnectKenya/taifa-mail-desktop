<Window
    x:Class="TaifaMail.App.Views.ComposeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:TaifaMail.App.Controls"
    xmlns:svc="using:TaifaMail.App.Services"
    xmlns:vm="using:TaifaMail.Core.Compose"
    Title="New message">
  <Grid x:Name="Root" Background="{ThemeResource TmPanelBrush}" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid x:Name="TitleRow" Height="40" Background="Transparent">
      <TextBlock x:Name="TitleText" Text="New message" Style="{StaticResource TmBodyStrong}" VerticalAlignment="Center" Margin="16,0,0,0"/>
    </Grid>

    <StackPanel Grid.Row="1" Padding="16,0" Spacing="0">
      <Grid MinHeight="40" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource TmBorderSoftBrush}" ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="From" Style="{StaticResource TmMeta}" VerticalAlignment="Center"/>
        <TextBlock x:Name="FromText" Grid.Column="1" Style="{StaticResource TmMonoText}" VerticalAlignment="Center"/>
      </Grid>
      <Grid MinHeight="40" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource TmBorderSoftBrush}" ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="To" Style="{StaticResource TmMeta}" VerticalAlignment="Center"/>
        <ContentControl x:Name="ToHost" Grid.Column="1" HorizontalContentAlignment="Stretch" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <HyperlinkButton x:Name="CcLink" Content="Cc" Click="OnShowCc" Foreground="{ThemeResource TmAccentInkBrush}" Padding="6,0"/>
          <HyperlinkButton x:Name="BccLink" Content="Bcc" Click="OnShowBcc" Foreground="{ThemeResource TmAccentInkBrush}" Padding="6,0"/>
        </StackPanel>
      </Grid>
      <Grid x:Name="CcRow" Visibility="Collapsed" MinHeight="40" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource TmBorderSoftBrush}" ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="Cc" Style="{StaticResource TmMeta}" VerticalAlignment="Center"/>
        <ContentControl x:Name="CcHost" Grid.Column="1" HorizontalContentAlignment="Stretch" VerticalAlignment="Center"/>
      </Grid>
      <Grid x:Name="BccRow" Visibility="Collapsed" MinHeight="40" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource TmBorderSoftBrush}" ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="Bcc" Style="{StaticResource TmMeta}" VerticalAlignment="Center"/>
        <ContentControl x:Name="BccHost" Grid.Column="1" HorizontalContentAlignment="Stretch" VerticalAlignment="Center"/>
      </Grid>
      <Grid MinHeight="40" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource TmBorderSoftBrush}" ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="Subject" Style="{StaticResource TmMeta}" VerticalAlignment="Center"/>
        <TextBox x:Name="SubjectBox" Grid.Column="1" BorderThickness="0" Background="Transparent" MinHeight="40" AutomationProperties.Name="Subject" FontFamily="{StaticResource TmFontMedium}" TextChanged="OnSubjectChanged"/>
      </Grid>
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="2" Padding="12,6">
      <Button Style="{StaticResource TmToolButton}" Click="OnBold" ToolTipService.ToolTip="Bold (Ctrl+B)" AutomationProperties.Name="Bold"><ctl:IconView IconName="bold" Size="16" Foreground="{ThemeResource TmText2Brush}"/></Button>
      <Button Style="{StaticResource TmToolButton}" Click="OnItalic" ToolTipService.ToolTip="Italic (Ctrl+I)" AutomationProperties.Name="Italic"><ctl:IconView IconName="italic" Size="16" Foreground="{ThemeResource TmText2Brush}"/></Button>
      <Button Style="{StaticResource TmToolButton}" Click="OnBullets" ToolTipService.ToolTip="Bulleted list" AutomationProperties.Name="Bulleted list"><ctl:IconView IconName="list-bullet" Size="16" Foreground="{ThemeResource TmText2Brush}"/></Button>
      <Button Style="{StaticResource TmToolButton}" Click="OnNumbers" ToolTipService.ToolTip="Numbered list" AutomationProperties.Name="Numbered list"><ctl:IconView IconName="list-number" Size="16" Foreground="{ThemeResource TmText2Brush}"/></Button>
      <Button Style="{StaticResource TmToolButton}" Click="OnLink" ToolTipService.ToolTip="Insert link" AutomationProperties.Name="Insert link"><ctl:IconView IconName="link" Size="16" Foreground="{ThemeResource TmText2Brush}"/></Button>
      <Border Width="1" Height="16" Margin="6,0" Background="{ThemeResource TmBorderBrush}"/>
      <Button Style="{StaticResource TmToolButton}" Click="OnAttach" ToolTipService.ToolTip="Attach files" AutomationProperties.Name="Attach files"><ctl:IconView IconName="attach" Size="16" Foreground="{ThemeResource TmText2Brush}"/></Button>
    </StackPanel>

    <RichEditBox x:Name="Editor" Grid.Row="3" BorderThickness="0" Background="Transparent" Padding="16,8" AutomationProperties.Name="Message" TextChanged="OnEditorChanged"
                 FontFamily="{StaticResource TmFont}" FontSize="14" IsSpellCheckEnabled="True" AcceptsReturn="True"/>

    <ItemsControl x:Name="AttachmentStrip" Grid.Row="4" Padding="16,0" Visibility="Collapsed">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><ctl:WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:AttachmentVm">
          <Grid Height="40" MinWidth="200" Margin="0,0,8,8" CornerRadius="8" Background="{ThemeResource TmPanel2Brush}" Padding="12,0,4,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{x:Bind Name}" Style="{StaticResource TmBody}" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
              <TextBlock Text="{x:Bind svc:Fmt.AttachmentLine(SizeText, State), Mode=OneWay}" Style="{StaticResource TmCaption}"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource TmToolButton}" Click="OnRemoveAttachment" Tag="{x:Bind}" AutomationProperties.Name="Remove attachment"><ctl:IconView IconName="close-plain" Size="16" Foreground="{ThemeResource TmText3Brush}"/></Button>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Grid.Row="5" Padding="16,0,16,8" Spacing="8">
      <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="False" IsOpen="False"/>
      <InfoBar x:Name="NoticeBar" Severity="Warning" IsClosable="True" IsOpen="False"/>
    </StackPanel>

    <Grid Grid.Row="6" Padding="16,12" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource TmBorderSoftBrush}" ColumnSpacing="8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="DraftText" Style="{StaticResource TmCaption}" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Content="Discard" Style="{StaticResource TmTextButton}" Foreground="{ThemeResource TmDangerFgBrush}" Click="OnDiscard" Height="40"/>
      <Button x:Name="SendButton" Grid.Column="2" Style="{StaticResource TmPrimaryButton}" Click="OnSend" MinWidth="104" ToolTipService.ToolTip="Send (Ctrl+Enter)" AutomationProperties.Name="Send">
        <Grid>
          <StackPanel x:Name="SendLabel" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"><ctl:IconView IconName="sent" Size="16" Foreground="White"/><TextBlock Text="Send"/></StackPanel>
          <StackPanel x:Name="SendingLabel" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Visibility="Collapsed"><ProgressRing Width="16" Height="16" IsActive="True" Foreground="White"/><TextBlock Text="Sending"/></StackPanel>
        </Grid>
      </Button>
    </Grid>
  </Grid>
</Window>
