<Page
    x:Class="TaifaMail.App.Views.WebSetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:TaifaMail.App.Controls">
  <Grid Background="{ThemeResource TmBgBrush}">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="TitleRow" Background="Transparent"/>
    <Border Grid.Row="1" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Padding="24" CornerRadius="16" BorderThickness="1"
            Background="{ThemeResource TmPanelBrush}" BorderBrush="{ThemeResource TmBorderBrush}">
      <StackPanel Spacing="16">
        <ctl:LogoView HeightPx="56" HorizontalAlignment="Left"/>
        <TextBlock Text="Finish setting up your mailbox" Style="{StaticResource TmDisplay}" TextWrapping="Wrap"/>
        <TextBlock x:Name="Body" Style="{StaticResource TmMeta}" TextWrapping="Wrap"/>
        <Button Content="Open Taifa Mail on the web" Style="{StaticResource TmPrimaryButton}" HorizontalAlignment="Stretch" Click="OnOpenWeb"/>
        <Button Content="Sign out" Style="{StaticResource TmTextButton}" HorizontalAlignment="Stretch" Click="OnSignOut"/>
      </StackPanel>
    </Border>
  </Grid>
</Page>
