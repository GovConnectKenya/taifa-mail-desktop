<Window
    x:Class="TaifaMail.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:TaifaMail.App.Controls"
    Title="Settings">
  <Grid x:Name="Root" Background="{ThemeResource TmBgBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="TitleRow" Grid.ColumnSpan="2" Background="Transparent">
      <TextBlock Text="Settings" Style="{StaticResource TmBodyStrong}" VerticalAlignment="Center" Margin="16,0,0,0"/>
    </Grid>
    <ListView x:Name="Panes" Grid.Row="1" Background="{ThemeResource TmSidebarBrush}" SelectionChanged="OnPaneChanged" Padding="8,8" AutomationProperties.Name="Settings sections">
      <ListViewItem Content="General" Tag="General" IsSelected="True" CornerRadius="8" MinHeight="36"/>
      <ListViewItem Content="Notifications" Tag="Notifications" CornerRadius="8" MinHeight="36"/>
      <ListViewItem Content="Signature" Tag="Signature" CornerRadius="8" MinHeight="36"/>
      <ListViewItem Content="Auto-reply" Tag="AutoReply" CornerRadius="8" MinHeight="36"/>
      <ListViewItem Content="Account" Tag="Account" CornerRadius="8" MinHeight="36"/>
    </ListView>
    <ScrollViewer Grid.Row="1" Grid.Column="1">
      <Grid Padding="32,24" MaxWidth="640" HorizontalAlignment="Left">
        <StackPanel x:Name="GeneralPane" Spacing="20">
          <TextBlock Text="General" Style="{StaticResource TmDisplay}"/>
          <StackPanel Spacing="8">
            <TextBlock Text="Theme" Style="{StaticResource TmBodyStrong}"/>
            <RadioButtons x:Name="ThemeChoice" SelectionChanged="OnThemeChanged" AutomationProperties.Name="Theme">
              <x:String>System</x:String>
              <x:String>Light</x:String>
              <x:String>Dark</x:String>
            </RadioButtons>
          </StackPanel>
          <StackPanel Spacing="8">
            <TextBlock Text="List density" Style="{StaticResource TmBodyStrong}"/>
            <RadioButtons x:Name="DensityChoice" SelectionChanged="OnDensityChanged" AutomationProperties.Name="List density">
              <x:String>Comfortable</x:String>
              <x:String>Compact</x:String>
            </RadioButtons>
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="NotificationsPane" Spacing="16" Visibility="Collapsed">
          <TextBlock Text="Notifications" Style="{StaticResource TmDisplay}"/>
          <ToggleSwitch x:Name="AlertsToggle" Header="New mail notifications" OnContent="On" OffContent="Off" Toggled="OnAlertsToggled"/>
          <ToggleSwitch x:Name="BadgeToggle" Header="Taskbar badge with the Inbox unread count" OnContent="On" OffContent="Off" Toggled="OnBadgeToggled"/>
          <TextBlock Text="Notifications arrive while Taifa Mail is running." Style="{StaticResource TmMeta}"/>
        </StackPanel>
        <StackPanel x:Name="SignaturePane" Spacing="12" Visibility="Collapsed">
          <TextBlock Text="Signature" Style="{StaticResource TmDisplay}"/>
          <ProgressBar x:Name="SignatureLoading" IsIndeterminate="True"/>
          <InfoBar x:Name="SignatureError" Severity="Error" IsClosable="False" IsOpen="False"/>
          <TextBox x:Name="SignatureBox" Style="{StaticResource TmFieldBox}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" AutomationProperties.Name="Signature"/>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="Save" Style="{StaticResource TmPrimaryButton}" Click="OnSaveSignature"/>
            <TextBlock x:Name="SignatureSaved" Style="{StaticResource TmMeta}" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="AutoReplyPane" Spacing="12" Visibility="Collapsed">
          <TextBlock Text="Auto-reply" Style="{StaticResource TmDisplay}"/>
          <ProgressBar x:Name="AutoLoading" IsIndeterminate="True"/>
          <InfoBar x:Name="AutoError" Severity="Error" IsClosable="False" IsOpen="False"/>
          <ToggleSwitch x:Name="AutoEnabled" Header="Send automatic replies" OnContent="On" OffContent="Off"/>
          <TextBox x:Name="AutoSubject" Header="Subject" Style="{StaticResource TmFieldBox}"/>
          <TextBox x:Name="AutoMessage" Header="Message" Style="{StaticResource TmFieldBox}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120"/>
          <ComboBox x:Name="AutoMode" Header="When" SelectionChanged="OnAutoModeChanged" MinWidth="240" MinHeight="40">
            <ComboBoxItem Content="Always" Tag="always"/>
            <ComboBoxItem Content="Outside working hours" Tag="outside_hours"/>
            <ComboBoxItem Content="During a date range" Tag="date_range"/>
          </ComboBox>
          <StackPanel x:Name="AutoHours" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
            <NumberBox x:Name="AutoStartHour" Header="Work starts at (hour)" Minimum="0" Maximum="23" SpinButtonPlacementMode="Compact"/>
            <NumberBox x:Name="AutoEndHour" Header="Work ends at (hour)" Minimum="0" Maximum="24" SpinButtonPlacementMode="Compact"/>
          </StackPanel>
          <StackPanel x:Name="AutoRange" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
            <CalendarDatePicker x:Name="AutoStart" Header="From"/>
            <CalendarDatePicker x:Name="AutoEnd" Header="To"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="Save" Style="{StaticResource TmPrimaryButton}" Click="OnSaveAuto"/>
            <TextBlock x:Name="AutoSaved" Style="{StaticResource TmMeta}" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="AccountPane" Spacing="16" Visibility="Collapsed">
          <TextBlock Text="Account" Style="{StaticResource TmDisplay}"/>
          <StackPanel Spacing="4">
            <TextBlock Text="Mailbox" Style="{StaticResource TmMeta}"/>
            <TextBlock x:Name="AccountAddress" Style="{StaticResource TmMonoText}" FontSize="13" Foreground="{ThemeResource TmTextBrush}"/>
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Storage" Style="{StaticResource TmMeta}"/>
            <ProgressBar x:Name="AccountQuota" Minimum="0" Maximum="100" Height="4" CornerRadius="2" Foreground="{ThemeResource TmAccentFgBrush}" Background="{ThemeResource TmPanel3Brush}"/>
            <TextBlock x:Name="AccountQuotaText" Style="{StaticResource TmCaption}"/>
          </StackPanel>
          <Button Content="Sign out" Style="{StaticResource TmTextButton}" Foreground="{ThemeResource TmDangerFgBrush}" HorizontalAlignment="Left" Click="OnSignOut"/>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
