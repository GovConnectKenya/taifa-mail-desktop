<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Mapped one to one from the webmail design tokens (frontend/src/lib/styles/tokens.css) as listed in docs/native/DESIGN_SPEC.md section 3. Do not add raw values in views. -->

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="TmSelectedRowBrush" Color="#29008C51"/>
      <SolidColorBrush x:Key="TmRingBrush" Color="#008C51"/>
      <Color x:Key="SystemAccentColor">#008C51</Color>
      <Color x:Key="SystemAccentColorLight1">#008C51</Color>
