      <StaticResource x:Key="NavigationViewItemForegroundSelectedPressed" ResourceKey="TmAccentInkBrush"/>
      <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent"/>
      <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
      <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>

      <SolidColorBrush x:Key="TmBgBrush" Color="#F5F8F6"/>
      <SolidColorBrush x:Key="TmPanelBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="TmSidebarBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="TmPanel2Brush" Color="#EDF3EF"/>
      <SolidColorBrush x:Key="TmPanel3Brush" Color="#DCE5DF"/>
      <SolidColorBrush x:Key="TmSelectedBrush" Color="#E3F0E8"/>
      <SolidColorBrush x:Key="TmBorderBrush" Color="#DCE5DF"/>
      <SolidColorBrush x:Key="TmBorder2Brush" Color="#C3D0C8"/>
      <SolidColorBrush x:Key="TmBorderSoftBrush" Color="#E8EEEA"/>
      <SolidColorBrush x:Key="TmSelBorderBrush" Color="#DCE5DF"/>
      <SolidColorBrush x:Key="TmTextBrush" Color="#000000"/>
      <SolidColorBrush x:Key="TmText2Brush" Color="#52665E"/>
      <SolidColorBrush x:Key="TmText3Brush" Color="#5C6F67"/>
      <SolidColorBrush x:Key="TmText4Brush" Color="#8DA096"/>
      <SolidColorBrush x:Key="TmAccentBrush" Color="#00864E"/>
      <SolidColorBrush x:Key="TmAccentHoverBrush" Color="#007343"/>
      <SolidColorBrush x:Key="TmOnAccentBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="TmAccentFgBrush" Color="#008C51"/>
      <SolidColorBrush x:Key="TmAccentInkBrush" Color="#00643A"/>
      <SolidColorBrush x:Key="TmAccentSoftBrush" Color="#E6F4EE"/>
      <SolidColorBrush x:Key="TmAccentSoft2Brush" Color="#E3F0E8"/>
      <SolidColorBrush x:Key="TmDangerBrush" Color="#922529"/>
      <SolidColorBrush x:Key="TmDangerFgBrush" Color="#741D20"/>
      <SolidColorBrush x:Key="TmDangerSoftBrush" Color="#F8E4E2"/>
      <SolidColorBrush x:Key="TmWarnBrush" Color="#8A6400"/>
      <SolidColorBrush x:Key="TmWarnFgBrush" Color="#6B4E00"/>
      <SolidColorBrush x:Key="TmWarnSoftBrush" Color="#FAF3D9"/>
      <SolidColorBrush x:Key="TmFlagBrush" Color="#8A6400"/>
      <SolidColorBrush x:Key="TmTrackBrush" Color="#E6ECE8"/>
      <SolidColorBrush x:Key="TmFocusBrush" Color="#008C51"/>
      <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="TmSelectedRowBrush"/>
      <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="TmSelectedRowBrush"/>
      <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="TmSelectedRowBrush"/>
      <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="TmPanel2Brush"/>
      <StaticResource x:Key="ListViewItemBackgroundPressed" ResourceKey="TmPanel3Brush"/>
      <StaticResource x:Key="AccentButtonBackground" ResourceKey="TmAccentBrush"/>
      <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="TmAccentHoverBrush"/>
      <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="TmAccentHoverBrush"/>
      <StaticResource x:Key="AccentButtonForeground" ResourceKey="TmOnAccentBrush"/>
      <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="TmOnAccentBrush"/>
      <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="TmOnAccentBrush"/>
      <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent"/>
      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent"/>
      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="Transparent"/>
      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="Transparent"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="TmSelectedRowBrush" Color="#291EA94E"/>
      <SolidColorBrush x:Key="TmRingBrush" Color="#1EA94E"/>
      <Color x:Key="SystemAccentColor">#1EA94E</Color>
      <Color x:Key="SystemAccentColorLight1">#1EA94E</Color>
      <Color x:Key="SystemAccentColorLight2">#1EA94E</Color>
      <Color x:Key="SystemAccentColorLight3">#1EA94E</Color>
      <Color x:Key="SystemAccentColorDark1">#1A8F44</Color>
      <Color x:Key="SystemAccentColorDark2">#1A8F44</Color>
      <Color x:Key="SystemAccentColorDark3">#1A8F44</Color>
      <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="TmSidebarBrush"/>
      <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="TmSidebarBrush"/>
      <StaticResource x:Key="NavigationViewItemBackgroundSelected" ResourceKey="TmAccentSoftBrush"/>
      <StaticResource x:Key="NavigationViewItemBackgroundSelectedPointerOver" ResourceKey="TmAccentSoftBrush"/>
      <StaticResource x:Key="NavigationViewItemBackgroundSelectedPressed" ResourceKey="TmAccentSoftBrush"/>
      <StaticResource x:Key="NavigationViewItemBackgroundPointerOver" ResourceKey="TmPanel2Brush"/>
      <StaticResource x:Key="NavigationViewItemBackgroundPressed" ResourceKey="TmPanel3Brush"/>
      <StaticResource x:Key="NavigationViewItemForegroundSelected" ResourceKey="TmAccentInkBrush"/>
      <StaticResource x:Key="NavigationViewItemForegroundSelectedPointerOver" ResourceKey="TmAccentInkBrush"/>
      <StaticResource x:Key="NavigationViewItemForegroundSelectedPressed" ResourceKey="TmAccentInkBrush"/>
      <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent"/>
      <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
      <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>

      <SolidColorBrush x:Key="TmBgBrush" Color="#101010"/>
      <SolidColorBrush x:Key="TmPanelBrush" Color="#161616"/>
      <SolidColorBrush x:Key="TmSidebarBrush" Color="#141414"/>
      <SolidColorBrush x:Key="TmPanel2Brush" Color="#242424"/>
      <SolidColorBrush x:Key="TmPanel3Brush" Color="#2E2E2E"/>
      <SolidColorBrush x:Key="TmSelectedBrush" Color="#1D2E24"/>
      <SolidColorBrush x:Key="TmBorderBrush" Color="#2E2E2E"/>
      <SolidColorBrush x:Key="TmBorder2Brush" Color="#3D3D3D"/>
      <SolidColorBrush x:Key="TmBorderSoftBrush" Color="#222222"/>
      <SolidColorBrush x:Key="TmSelBorderBrush" Color="#2E2E2E"/>
      <SolidColorBrush x:Key="TmTextBrush" Color="#ECECEC"/>
      <SolidColorBrush x:Key="TmText2Brush" Color="#A8A8A8"/>
      <SolidColorBrush x:Key="TmText3Brush" Color="#949494"/>
      <SolidColorBrush x:Key="TmText4Brush" Color="#8A8A8A"/>
      <SolidColorBrush x:Key="TmAccentBrush" Color="#16803C"/>
      <SolidColorBrush x:Key="TmAccentHoverBrush" Color="#1A8F44"/>
      <SolidColorBrush x:Key="TmOnAccentBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="TmAccentFgBrush" Color="#1EA94E"/>
      <SolidColorBrush x:Key="TmAccentInkBrush" Color="#8ADBAA"/>
      <SolidColorBrush x:Key="TmAccentSoftBrush" Color="#241EA94E"/>
      <SolidColorBrush x:Key="TmAccentSoft2Brush" Color="#1D2E24"/>
      <SolidColorBrush x:Key="TmDangerBrush" Color="#FF7A5E"/>
      <SolidColorBrush x:Key="TmDangerFgBrush" Color="#FFA892"/>
      <SolidColorBrush x:Key="TmDangerSoftBrush" Color="#2DD63F28"/>
      <SolidColorBrush x:Key="TmWarnBrush" Color="#E0B22E"/>
      <SolidColorBrush x:Key="TmWarnFgBrush" Color="#F0D27A"/>
      <SolidColorBrush x:Key="TmWarnSoftBrush" Color="#24D9A514"/>
      <SolidColorBrush x:Key="TmFlagBrush" Color="#E0B22E"/>
      <SolidColorBrush x:Key="TmTrackBrush" Color="#1A1A1A"/>
      <SolidColorBrush x:Key="TmFocusBrush" Color="#1EA94E"/>
      <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="TmSelectedRowBrush"/>
      <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="TmSelectedRowBrush"/>
      <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="TmSelectedRowBrush"/>
      <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="TmPanel2Brush"/>
      <StaticResource x:Key="ListViewItemBackgroundPressed" ResourceKey="TmPanel3Brush"/>
      <StaticResource x:Key="AccentButtonBackground" ResourceKey="TmAccentBrush"/>
      <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="TmAccentHoverBrush"/>
      <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="TmAccentHoverBrush"/>
      <StaticResource x:Key="AccentButtonForeground" ResourceKey="TmOnAccentBrush"/>
      <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="TmOnAccentBrush"/>
      <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="TmOnAccentBrush"/>
      <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent"/>
      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent"/>
      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="Transparent"/>
      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="Transparent"/>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Spacing scale (4 point grid, spec section 1) -->
  <x:Double x:Key="Space1">4</x:Double>
  <x:Double x:Key="Space2">8</x:Double>
  <x:Double x:Key="Space3">12</x:Double>
  <x:Double x:Key="Space4">16</x:Double>
  <x:Double x:Key="Space5">20</x:Double>
  <x:Double x:Key="Space6">24</x:Double>
  <x:Double x:Key="Space8">32</x:Double>

  <CornerRadius x:Key="RadiusXs">4</CornerRadius>
  <CornerRadius x:Key="RadiusCtl">8</CornerRadius>
  <CornerRadius x:Key="RadiusCard">12</CornerRadius>
  <CornerRadius x:Key="RadiusPanel">16</CornerRadius>

  <!-- Fonts: the open Google Sans the webmail ships (SIL OFL) and JetBrains Mono, one file per weight.
       Windows resolves the legacy family name of each file, so a weight is a family here. -->
  <FontFamily x:Key="TmFont">ms-appx:///Assets/Fonts/GoogleSans-Regular.ttf#Google Sans</FontFamily>
  <FontFamily x:Key="TmFontMedium">ms-appx:///Assets/Fonts/GoogleSans-Medium.ttf#Google Sans Medium</FontFamily>
  <FontFamily x:Key="TmFontSemi">ms-appx:///Assets/Fonts/GoogleSans-SemiBold.ttf#Google Sans SemiBold</FontFamily>
  <FontFamily x:Key="TmMono">ms-appx:///Assets/Fonts/JetBrainsMono-Regular.ttf#JetBrains Mono</FontFamily>
  <FontFamily x:Key="TmMonoMedium">ms-appx:///Assets/Fonts/JetBrainsMono-Medium.ttf#JetBrains Mono Medium</FontFamily>
  <FontFamily x:Key="TmMonoSemi">ms-appx:///Assets/Fonts/JetBrainsMono-SemiBold.ttf#JetBrains Mono SemiBold</FontFamily>

  <Style x:Key="TmCaption" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TmFontMedium}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="LineHeight" Value="14"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="Foreground" Value="{ThemeResource TmText3Brush}"/>
  </Style>
  <Style x:Key="TmMeta" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TmFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="LineHeight" Value="16"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="Foreground" Value="{ThemeResource TmText2Brush}"/>
  </Style>
  <Style x:Key="TmBody" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TmFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="LineHeight" Value="18"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="CharacterSpacing" Value="-8"/>
    <Setter Property="Foreground" Value="{ThemeResource TmTextBrush}"/>
  </Style>
  <Style x:Key="TmBodyStrong" TargetType="TextBlock" BasedOn="{StaticResource TmBody}">
    <Setter Property="FontFamily" Value="{StaticResource TmFontSemi}"/>
  </Style>
  <Style x:Key="TmReader" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TmFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="LineHeight" Value="22"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="IsTextSelectionEnabled" Value="True"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Foreground" Value="{ThemeResource TmTextBrush}"/>
  </Style>
  <Style x:Key="TmTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TmFontSemi}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="LineHeight" Value="22"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="CharacterSpacing" Value="-8"/>
    <Setter Property="Foreground" Value="{ThemeResource TmTextBrush}"/>
  </Style>
  <Style x:Key="TmDisplay" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TmFontSemi}"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="LineHeight" Value="26"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="CharacterSpacing" Value="-10"/>
    <Setter Property="Foreground" Value="{ThemeResource TmTextBrush}"/>
  </Style>
  <Style x:Key="TmHero" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TmFontSemi}"/>
    <Setter Property="FontSize" Value="24"/>
    <Setter Property="LineHeight" Value="30"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="CharacterSpacing" Value="-8"/>
    <Setter Property="Foreground" Value="{ThemeResource TmTextBrush}"/>
  </Style>
  <Style x:Key="TmMonoText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TmMono}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="LineHeight" Value="16"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="Foreground" Value="{ThemeResource TmText3Brush}"/>
  </Style>

  <!-- Controls are 40 high (the webmail control height token); toolbars and dense rows use 32. -->
  <Style x:Key="TmPrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="FontFamily" Value="{StaticResource TmFontSemi}"/>
  </Style>
  <Style x:Key="TmFieldBox" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="FontFamily" Value="{StaticResource TmFont}"/>
  </Style>
  <Style x:Key="TmFieldMono" TargetType="TextBox" BasedOn="{StaticResource TmFieldBox}">
    <Setter Property="FontFamily" Value="{StaticResource TmMono}"/>
  </Style>
  <Style x:Key="TmFieldPassword" TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style x:Key="TmTextButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontFamily" Value="{StaticResource TmFont}"/>
  </Style>
  <!-- Toolbar tool: 32 wide, 28 hit height, hover surface2, pressed border1. -->
  <Style x:Key="TmToolButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="MinWidth" Value="32"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="6,0"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontFamily" Value="{StaticResource TmFontMedium}"/>
  </Style>
  <!-- Outlined pill: Reply, Reply all, Forward, Try again. 40 high. -->
  <Style x:Key="TmPillButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="Padding" Value="20,0"/>
    <Setter Property="CornerRadius" Value="20"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{ThemeResource TmBorder2Brush}"/>
    <Setter Property="FontFamily" Value="{StaticResource TmFontMedium}"/>
  </Style>
  <!-- Sidebar Compose: 48 high, accentFill, white 13/600. -->
  <Style x:Key="TmComposeButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="MinHeight" Value="48"/>
    <Setter Property="Height" Value="48"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="FontFamily" Value="{StaticResource TmFontSemi}"/>
  </Style>

  <!-- Thread list row container: flat ruled list, radius 0, content height. Selected is a fill only. -->
  <Style x:Key="TmRowContainer" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="UseSystemFocusVisuals" Value="False"/>
  </Style>
</ResourceDictionary>
