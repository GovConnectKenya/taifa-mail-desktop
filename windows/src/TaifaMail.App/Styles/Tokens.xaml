      <Color x:Key="SystemAccentColorLight3">#008C51</Color>
      <Color x:Key="SystemAccentColorDark1">#00643A</Color>
      <Color x:Key="SystemAccentColorDark2">#00643A</Color>
      <Color x:Key="SystemAccentColorDark3">#00643A</Color>
      <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="TmSidebarBrush"/>
      <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="TmSidebarBrush"/>
      <StaticResource x:Key="NavigationViewItemBackgroundSelected" ResourceKey="TmAccentSoftBrush"/>
      <StaticResource x:Key="NavigationViewItemBackgroundSelectedPointerOver" ResourceKey="TmAccentSoftBrush"/>
      <StaticResource x:Key="NavigationViewItemBackgroundSelectedPressed" ResourceKey="TmAccentSoftBrush"/>
      <StaticResource x:Key="NavigationViewItemBackgroundPointerOver" ResourceKey="TmPanel2Brush"/>
      <StaticResource x:Key="NavigationViewItemBackgroundPressed" ResourceKey="TmPanel3Brush"/>
      <StaticResource x:Key="NavigationViewItemForegroundSelected" ResourceKey="TmAccentInkBrush"/>
