<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- Windows 10 1809 is the floor; Windows App SDK 1.8 supports it. -->
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>TaifaMail.App</RootNamespace>
    <AssemblyName>TaifaMail</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged and self contained: an xcopy folder, no certificate or store needed to run it. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationIcon>Assets\taifa.ico</ApplicationIcon>
    <DefaultLanguage>en-US</DefaultLanguage>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.1.0</Version>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- The fixture backed preview mode exists only in Debug: both the define and the files drop out of Release. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);PREVIEW_DATA</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="Preview\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaifaMail.Core\TaifaMail.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\*.*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Logo\*.*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\taifa.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\NOTICE-icons.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
